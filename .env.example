# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in what you need.
# The site runs without any of these — the intake chat falls back to a
# scripted flow when no AI key is present — but the AI makes it far better.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Postgres. Required — there is no local-file fallback, because a SQLite file is
# too easy to lose: it was silently recreated empty on the host this project
# started on, taking every client request with it.
#
# In production this points at Postgres on the same machine as the app, over
# localhost. For local development, run Postgres locally or point this at any
# throwaway database — just not the production one.
DATABASE_URL="postgresql://malikov:password@localhost:5432/malikov_dev"

# --- Public site URL -------------------------------------------------------
# Absolute base for canonical links, hreflang and Open Graph tags. No trailing
# slash. Read at BUILD time, not run time — changing it means rebuilding.
# Only needed if the site is not on https://malikov-dev.uz.
NEXT_PUBLIC_SITE_URL=""

# --- AI provider -----------------------------------------------------------
# Set ONE of these. The app auto-detects which key exists, in this order:
# Gemini -> OpenAI -> Anthropic. Set AI_PROVIDER to force a specific one.

# https://aistudio.google.com/apikey  (has a free tier)
GEMINI_API_KEY=""

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional overrides: "gemini" | "openai" | "anthropic"
AI_PROVIDER=""
AI_MODEL=""

# --- Admin panel -----------------------------------------------------------
# The password for /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="dev-only-insecure-secret-change-me"

# --- Optional: Telegram notification on every new request ------------------
# Create a bot with @BotFather, then message it once and get your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
