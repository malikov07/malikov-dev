# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in what you need.
# The site runs without any of these — the intake chat falls back to a
# scripted flow when no AI key is present — but the AI makes it far better.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Postgres. Required — there is no local-file fallback, because on a serverless
# host that fallback silently wrote client requests to a disk that was about to
# be thrown away.
#
# On Neon, use the POOLED connection string (the host contains `-pooler`).
# The direct one runs out of connections as soon as a few instances are warm.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Public site URL -------------------------------------------------------
# Absolute base for canonical links, hreflang and Open Graph tags. No trailing
# slash. Only needed if the site is not on https://malikov-dev.uz — set it on
# preview deploys so they do not claim to be the production URL.
NEXT_PUBLIC_SITE_URL=""

# --- AI provider -----------------------------------------------------------
# Set ONE of these. The app auto-detects which key exists, in this order:
# Gemini -> OpenAI -> Anthropic. Set AI_PROVIDER to force a specific one.

# https://aistudio.google.com/apikey  (has a free tier)
GEMINI_API_KEY=""

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional overrides: "gemini" | "openai" | "anthropic"
AI_PROVIDER=""
AI_MODEL=""

# --- Admin panel -----------------------------------------------------------
# The password for /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="dev-only-insecure-secret-change-me"

# --- Optional: Telegram notification on every new request ------------------
# Create a bot with @BotFather, then message it once and get your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
